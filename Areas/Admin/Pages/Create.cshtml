@page
@model WT_Lab.Areas.Admin.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Asset</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Asset.Name" class="control-label"></label>
                <input asp-for="Asset.Name" class="form-control" />
                <span asp-validation-for="Asset.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Asset.Description" class="control-label"></label>
                <input asp-for="Asset.Description" class="form-control" />
                <span asp-validation-for="Asset.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Asset.InvNumber" class="control-label"></label>
                <input asp-for="Asset.InvNumber" class="form-control" />
                <span asp-validation-for="Asset.InvNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Asset.Price" class="control-label"></label>
                <input asp-for="Asset.Price" class="form-control" />
                <span asp-validation-for="Asset.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="Asset.Category" />
            </div>
            <div class="form-group">
                <label asp-for="Asset.Category" class="control-label"></label>
                <select asp-for="Asset.Category" asp-items="@((SelectList)ViewData["CategoryId"])" class="form-control"></select>
                <span asp-validation-for="Asset.Category" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Photo" class="form-label">Изображение</label>
                <input asp-for="Photo" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}